# ProfitMax AI - Environment Variables
# Copy this file to .env and fill in your values:
# cp .env.example .env

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Options: local, Neon.tech (free), Supabase (free)
DATABASE_URL="postgresql://user:password@localhost:5432/profitmax?schema=public"

# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk redirect URLs (defaults work for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# =============================================================================
# ANTHROPIC AI (Max's Brain)
# =============================================================================
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# =============================================================================
# RESEND EMAIL (Optional - for order notifications)
# =============================================================================
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
